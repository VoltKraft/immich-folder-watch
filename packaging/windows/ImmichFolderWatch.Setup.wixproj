<Project Sdk="WixToolset.Sdk/6.0.2">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <InstallerPlatform Condition="'$(InstallerPlatform)' == ''">x64</InstallerPlatform>
    <InstallerVersion Condition="'$(InstallerVersion)' == ''">0.1.0</InstallerVersion>
    <PublishedAppDir Condition="'$(PublishedAppDir)' == ''">$(MSBuildProjectDirectory)\..\..\artifacts\windows\msi\publish\win-x64</PublishedAppDir>
    <ExampleConfigPath Condition="'$(ExampleConfigPath)' == ''">$(MSBuildProjectDirectory)\..\..\examples\config.example.yaml</ExampleConfigPath>
    <OutputName Condition="'$(OutputName)' == ''">immich-folder-watch</OutputName>
    <DefineConstants>PublishedAppDir=$(PublishedAppDir);ExampleConfigPath=$(ExampleConfigPath);InstallerVersion=$(InstallerVersion);$(DefineConstants)</DefineConstants>
  </PropertyGroup>
</Project>
