<Project Sdk="WixToolset.Sdk/6.0.2">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <InstallerPlatform Condition="'$(InstallerPlatform)' == ''">x64</InstallerPlatform>
    <InstallerVersion Condition="'$(InstallerVersion)' == ''">2.3.0</InstallerVersion>
    <PublishedAppDir Condition="'$(PublishedAppDir)' == ''">$(MSBuildProjectDirectory)\..\..\artifacts\windows\msi\publish\win-x64</PublishedAppDir>
    <BrandingIconPath Condition="'$(BrandingIconPath)' == ''">$(MSBuildProjectDirectory)\..\..\artifacts\branding\windows\app.ico</BrandingIconPath>
    <OutputName Condition="'$(OutputName)' == ''">immich-folder-watch</OutputName>
    <DefineConstants>PublishedAppDir=$(PublishedAppDir);InstallerVersion=$(InstallerVersion);BrandingIconPath=$(BrandingIconPath);$(DefineConstants)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" Version="6.0.2" />
  </ItemGroup>
</Project>
