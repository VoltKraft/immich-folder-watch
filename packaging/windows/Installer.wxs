<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package
    Name="Immich Folder Watch"
    Manufacturer="VoltKraft"
    Version="$(InstallerVersion)"
    UpgradeCode="F82E51D6-6D61-4A5D-B8AA-9D84A5D0D57D"
    Language="1033"
    Scope="perMachine"
    InstallerVersion="500">

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="ImmichFolderWatch.ico" SourceFile="$(BrandingIconPath)" />
    <Property Id="ARPPRODUCTICON" Value="ImmichFolderWatch.ico" />

    <Property Id="LEGACYSERVICEINSTALLED">
      <RegistrySearch Root="HKLM" Key="SYSTEM\CurrentControlSet\Services\ImmichFolderWatch" Name="Start" Type="raw" />
    </Property>

    <util:CloseApplication
      Id="CloseImmichFolderWatch"
      Target="ImmichFolderWatch.exe"
      Description="Immich Folder Watch"
      CloseMessage="yes"
      EndSessionMessage="yes"
      TerminateProcess="10"
      PromptToContinue="no"
      RebootPrompt="no" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Immich Folder Watch">
        <Directory Id="BINDIR" Name="bin" />
      </Directory>
    </StandardDirectory>
    <Feature Id="MainFeature" Title="Immich Folder Watch" Level="1">
      <ComponentGroupRef Id="PublishedApplicationFiles" />
      <ComponentRef Id="AppExecutableComponent" />
      <ComponentRef Id="SqliteNativeComponent" />
      <ComponentRef Id="DesktopShortcutComponent" />
      <ComponentRef Id="EventLogRegistrationComponent" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="PublishedApplicationFiles">
      <Files Directory="BINDIR" Include="$(PublishedAppDir)\**">
        <Exclude Files="$(PublishedAppDir)\ImmichFolderWatch.exe" />
        <Exclude Files="$(PublishedAppDir)\e_sqlite3.dll" />
        <Exclude Files="$(PublishedAppDir)\**\*.pdb" />
      </Files>
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <Component Id="AppExecutableComponent" Directory="BINDIR" Guid="*">
      <File Id="AppExecutableFile" Source="$(PublishedAppDir)\ImmichFolderWatch.exe" KeyPath="yes" />
    </Component>
  </Fragment>

  <Fragment>
    <Component Id="SqliteNativeComponent" Directory="BINDIR" Guid="*">
      <!-- The SQLite native library has no embedded language resource. Explicitly
           author one so MSI validation does not emit ICE60 for this non-versioned file. -->
      <File Id="SqliteNativeFile" Source="$(PublishedAppDir)\e_sqlite3.dll" DefaultLanguage="1033" />
    </Component>
  </Fragment>

  <Fragment>
    <Component Id="EventLogRegistrationComponent" Directory="BINDIR" Guid="A2F6C5E1-3DB0-4F8A-9C7B-2D8B1C1F4E40">
      <!--
        Remove any pre-existing source registration under the standard Application log
        before we write our own. Without this, a stale "Immich Folder Watch" source
        under Application would route writes to Application instead of our dedicated log
        (the .NET EventLog API enforces source/log alignment and throws otherwise; the
        underlying logger provider silently swallows the exception, which makes the
        dedicated log appear empty). RemoveOnInstall ensures fresh and upgrade installs
        leave the registry in a clean, correctly-mapped state.
      -->
      <RemoveRegistryKey
        Id="RemoveStaleApplicationSource"
        Action="removeOnInstall"
        Root="HKLM"
        Key="SYSTEM\CurrentControlSet\Services\EventLog\Application\Immich Folder Watch" />
      <RegistryKey Root="HKLM" Key="SYSTEM\CurrentControlSet\Services\EventLog\Immich Folder Watch">
        <RegistryValue Name="MaxSize" Type="integer" Value="1048576" />
        <RegistryValue Name="Retention" Type="integer" Value="0" />
        <RegistryValue Name="(Default)" Type="string" Value="" KeyPath="yes" />
      </RegistryKey>
      <RegistryKey Root="HKLM" Key="SYSTEM\CurrentControlSet\Services\EventLog\Immich Folder Watch\Immich Folder Watch">
        <RegistryValue Name="EventMessageFile" Type="expandable" Value="%SystemRoot%\Microsoft.NET\Framework64\v4.0.30319\EventLogMessages.dll" />
        <RegistryValue Name="TypesSupported" Type="integer" Value="7" />
      </RegistryKey>
    </Component>
  </Fragment>

  <Fragment>
    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcutComponent" Guid="*">
        <Shortcut
          Id="DesktopShortcut"
          Name="Immich Folder Watch"
          Description="Open the Immich Folder Watch configuration UI."
          Target="[BINDIR]ImmichFolderWatch.exe"
          Icon="ImmichFolderWatch.ico"
          IconIndex="0"
          WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue
          Root="HKCU"
          Key="Software\ImmichFolderWatch"
          Name="DesktopShortcutInstalled"
          Type="integer"
          Value="1"
          KeyPath="yes" />
      </Component>
    </StandardDirectory>
  </Fragment>

  <Fragment>
    <SetProperty
      Id="StopLegacyService"
      Value='"[SystemFolder]sc.exe" stop ImmichFolderWatch'
      Before="StopLegacyService"
      Sequence="execute" />
    <CustomAction
      Id="StopLegacyService"
      BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
      DllEntry="WixQuietExec"
      Execute="deferred"
      Impersonate="no"
      Return="ignore" />

    <SetProperty
      Id="RemoveLegacyService"
      Value='"[SystemFolder]sc.exe" delete ImmichFolderWatch'
      Before="RemoveLegacyService"
      Sequence="execute" />
    <CustomAction
      Id="RemoveLegacyService"
      BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
      DllEntry="WixQuietExec"
      Execute="deferred"
      Impersonate="no"
      Return="ignore" />

    <SetProperty
      Id="MigrateLegacyUserConfig"
      Value='"[BINDIR]ImmichFolderWatch.exe" --migrate-legacy-user'
      Before="MigrateLegacyUserConfig"
      Sequence="execute" />
    <CustomAction
      Id="MigrateLegacyUserConfig"
      BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
      DllEntry="WixQuietExec"
      Execute="deferred"
      Impersonate="yes"
      Return="ignore" />

    <SetProperty
      Id="RemoveLegacyProgramData"
      Value="&quot;[SystemFolder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -ExecutionPolicy Bypass -Command &quot;Remove-Item -LiteralPath ([IO.Path]::Combine($env:ProgramData, 'Immich Folder Watch')) -Recurse -Force -ErrorAction SilentlyContinue&quot;"
      Before="RemoveLegacyProgramData"
      Sequence="execute" />
    <CustomAction
      Id="RemoveLegacyProgramData"
      BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
      DllEntry="WixQuietExec"
      Execute="deferred"
      Impersonate="no"
      Return="ignore" />

    <SetProperty
      Id="WixShellExecTarget"
      Value="[BINDIR]ImmichFolderWatch.exe"
      Before="RelaunchAppAfterUpgrade"
      Sequence="execute" />
    <CustomAction
      Id="RelaunchAppAfterUpgrade"
      BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
      DllEntry="WixShellExec"
      Execute="immediate"
      Impersonate="yes"
      Return="ignore" />

    <InstallExecuteSequence>
      <Custom
        Action="StopLegacyService"
        Before="InstallFiles"
        Condition="NOT REMOVE AND LEGACYSERVICEINSTALLED" />
      <Custom
        Action="RemoveLegacyService"
        After="StopLegacyService"
        Condition="NOT REMOVE AND LEGACYSERVICEINSTALLED" />
      <Custom
        Action="MigrateLegacyUserConfig"
        After="InstallFiles"
        Condition="NOT REMOVE" />
      <Custom
        Action="RemoveLegacyProgramData"
        After="MigrateLegacyUserConfig"
        Condition="NOT REMOVE AND LEGACYSERVICEINSTALLED" />
      <Custom
        Action="RelaunchAppAfterUpgrade"
        After="InstallFinalize"
        Condition="WIX_UPGRADE_DETECTED AND NOT REMOVE~=&quot;ALL&quot;" />
    </InstallExecuteSequence>
  </Fragment>
</Wix>
