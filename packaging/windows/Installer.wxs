<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package
    Name="Immich Folder Watch"
    Manufacturer="VoltKraft"
    Version="$(InstallerVersion)"
    UpgradeCode="F82E51D6-6D61-4A5D-B8AA-9D84A5D0D57D"
    Language="1033"
    Scope="perMachine"
    InstallerVersion="500">

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="LEGACYCONFIGPATH">
      <DirectorySearch Id="LegacyConfigDirectorySearch" Path="[INSTALLFOLDER]">
        <FileSearch Id="LegacyConfigFileSearch" Name="config.yaml" />
      </DirectorySearch>
    </Property>

    <Property Id="STRUCTUREDCONFIGPATH">
      <DirectorySearch Id="StructuredConfigDirectorySearch" Path="[INSTALLFOLDER]config">
        <FileSearch Id="StructuredConfigFileSearch" Name="config.yaml" />
      </DirectorySearch>
    </Property>

    <Property Id="PROGRAMDATACONFIGPATH">
      <DirectorySearch Id="ProgramDataConfigDirectorySearch" Path="[DATADIR]">
        <FileSearch Id="ProgramDataConfigFileSearch" Name="config.yaml" />
      </DirectorySearch>
    </Property>

    <Property Id="EXISTINGSERVICESTART">
      <RegistrySearch Root="HKLM" Key="SYSTEM\CurrentControlSet\Services\ImmichFolderWatch" Name="Start" Type="raw" />
    </Property>

    <Property Id="EXISTINGDELAYEDAUTOSTART">
      <RegistrySearch Root="HKLM" Key="SYSTEM\CurrentControlSet\Services\ImmichFolderWatch" Name="DelayedAutoStart" Type="raw" />
    </Property>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Immich Folder Watch">
        <Directory Id="BINDIR" Name="bin" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="DATADIR" Name="Immich Folder Watch">
        <Directory Id="LOGSDIR" Name="logs" />
      </Directory>
    </StandardDirectory>
    <Feature Id="MainFeature" Title="Immich Folder Watch" Level="1">
      <ComponentGroupRef Id="PublishedApplicationFiles" />
      <ComponentRef Id="ServiceExecutableComponent" />
      <ComponentRef Id="GuiExecutableComponent" />
      <ComponentRef Id="AdminExecutableComponent" />
      <ComponentRef Id="LogsDirectoryComponent" />
      <ComponentRef Id="ConfigFileComponent" />
      <ComponentRef Id="DesktopShortcutComponent" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="PublishedApplicationFiles">
      <Files Directory="BINDIR" Include="$(PublishedAppDir)\**">
        <Exclude Files="$(PublishedAppDir)\ImmichFolderWatch.Daemon.exe" />
        <Exclude Files="$(PublishedAppDir)\ImmichFolderWatch.Gui.exe" />
        <Exclude Files="$(PublishedAppDir)\ImmichFolderWatch.Admin.exe" />
        <Exclude Files="$(PublishedAppDir)\**\*.pdb" />
      </Files>
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <Component Id="ServiceExecutableComponent" Directory="BINDIR" Guid="*">
      <File Id="ServiceExecutableFile" Source="$(PublishedAppDir)\ImmichFolderWatch.Daemon.exe" KeyPath="yes" />

      <ServiceInstall
        Id="ServiceInstaller"
        Name="ImmichFolderWatch"
        DisplayName="Immich Folder Watch"
        Description="Watches local folders and uploads new media to Immich."
        Type="ownProcess"
        Start="demand"
        ErrorControl="normal"
        Arguments='--config "[DATADIR]config.yaml"'>
      </ServiceInstall>

      <ServiceControl
        Id="ServiceController"
        Name="ImmichFolderWatch"
        Stop="both"
        Remove="uninstall"
        Wait="yes" />

      <util:ServiceConfig
        ServiceName="ImmichFolderWatch"
        FirstFailureActionType="restart"
        SecondFailureActionType="restart"
        ThirdFailureActionType="none"
        RestartServiceDelayInSeconds="5"
        ResetPeriodInDays="1" />
    </Component>
  </Fragment>

  <Fragment>
    <Component Id="GuiExecutableComponent" Directory="BINDIR" Guid="*">
      <File Id="GuiExecutableFile" Source="$(PublishedAppDir)\ImmichFolderWatch.Gui.exe" KeyPath="yes" />
    </Component>
  </Fragment>

  <Fragment>
    <Component Id="AdminExecutableComponent" Directory="BINDIR" Guid="*">
      <File Id="AdminExecutableFile" Source="$(PublishedAppDir)\ImmichFolderWatch.Admin.exe" KeyPath="yes" />
    </Component>
  </Fragment>

  <Fragment>
    <Component Id="LogsDirectoryComponent" Directory="LOGSDIR" Guid="*" Permanent="yes">
      <CreateFolder />
      <RegistryValue
        Root="HKLM"
        Key="Software\ImmichFolderWatch"
        Name="LogsDirectoryInstalled"
        Type="integer"
        Value="1"
        KeyPath="yes" />
    </Component>
  </Fragment>

  <Fragment>
    <Component
      Id="ConfigFileComponent"
      Directory="DATADIR"
      Guid="*"
      Permanent="yes"
      NeverOverwrite="yes"
      Condition="NOT PROGRAMDATACONFIGPATH AND NOT LEGACYCONFIGPATH AND NOT STRUCTUREDCONFIGPATH">
      <File
        Id="DefaultConfigFile"
        Source="$(ExampleConfigPath)"
        Name="config.yaml"
        KeyPath="yes" />
    </Component>
  </Fragment>

  <Fragment>
    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcutComponent" Guid="*">
        <Shortcut
          Id="DesktopShortcut"
          Name="Immich Folder Watch"
          Description="Open the Immich Folder Watch configuration UI."
          Target="[BINDIR]ImmichFolderWatch.Gui.exe"
          WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue
          Root="HKCU"
          Key="Software\ImmichFolderWatch"
          Name="DesktopShortcutInstalled"
          Type="integer"
          Value="1"
          KeyPath="yes" />
      </Component>
    </StandardDirectory>
  </Fragment>

  <Fragment>
    <SetProperty
      Id="RunDataLayoutMigration"
      Value='"[BINDIR]ImmichFolderWatch.Admin.exe" migrate-data-layout --legacy-install-root "[INSTALLFOLDER]"'
      Before="RunDataLayoutMigration"
      Sequence="execute" />
    <CustomAction
      Id="RunDataLayoutMigration"
      BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
      DllEntry="WixQuietExec"
      Execute="deferred"
      Impersonate="no"
      Return="check" />

    <SetProperty
      Id="PreserveUpgradeAutomaticDelayedStart"
      Value='"[SystemFolder]sc.exe" config ImmichFolderWatch start= delayed-auto'
      Before="PreserveUpgradeAutomaticDelayedStart"
      Sequence="execute" />
    <CustomAction
      Id="PreserveUpgradeAutomaticDelayedStart"
      BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
      DllEntry="WixQuietExec"
      Execute="deferred"
      Impersonate="no"
      Return="check" />

    <SetProperty
      Id="PreserveUpgradeAutomaticStart"
      Value='"[SystemFolder]sc.exe" config ImmichFolderWatch start= auto'
      Before="PreserveUpgradeAutomaticStart"
      Sequence="execute" />
    <CustomAction
      Id="PreserveUpgradeAutomaticStart"
      BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
      DllEntry="WixQuietExec"
      Execute="deferred"
      Impersonate="no"
      Return="check" />

    <SetProperty
      Id="PreserveUpgradeManualStart"
      Value='"[SystemFolder]sc.exe" config ImmichFolderWatch start= demand'
      Before="PreserveUpgradeManualStart"
      Sequence="execute" />
    <CustomAction
      Id="PreserveUpgradeManualStart"
      BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
      DllEntry="WixQuietExec"
      Execute="deferred"
      Impersonate="no"
      Return="check" />

    <SetProperty
      Id="NormalizeUpgradeDisabledToManual"
      Value='"[SystemFolder]sc.exe" config ImmichFolderWatch start= demand'
      Before="NormalizeUpgradeDisabledToManual"
      Sequence="execute" />
    <CustomAction
      Id="NormalizeUpgradeDisabledToManual"
      BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
      DllEntry="WixQuietExec"
      Execute="deferred"
      Impersonate="no"
      Return="check" />

    <InstallExecuteSequence>
      <Custom
        Action="RunDataLayoutMigration"
        After="InstallFiles"
        Condition="NOT REMOVE" />
      <Custom
        Action="PreserveUpgradeAutomaticDelayedStart"
        After="InstallServices"
        Condition="NOT REMOVE AND WIX_UPGRADE_DETECTED AND EXISTINGSERVICESTART = &quot;2&quot; AND EXISTINGDELAYEDAUTOSTART = &quot;1&quot;" />
      <Custom
        Action="PreserveUpgradeAutomaticStart"
        After="PreserveUpgradeAutomaticDelayedStart"
        Condition="NOT REMOVE AND WIX_UPGRADE_DETECTED AND EXISTINGSERVICESTART = &quot;2&quot; AND EXISTINGDELAYEDAUTOSTART &lt;&gt; &quot;1&quot;" />
      <Custom
        Action="PreserveUpgradeManualStart"
        After="PreserveUpgradeAutomaticStart"
        Condition="NOT REMOVE AND WIX_UPGRADE_DETECTED AND EXISTINGSERVICESTART = &quot;3&quot;" />
      <Custom
        Action="NormalizeUpgradeDisabledToManual"
        After="PreserveUpgradeManualStart"
        Condition="NOT REMOVE AND WIX_UPGRADE_DETECTED AND EXISTINGSERVICESTART = &quot;4&quot;" />
    </InstallExecuteSequence>
  </Fragment>
</Wix>
