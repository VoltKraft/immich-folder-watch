[Desktop Entry]
Type=Application
Name=Immich Folder Watch
GenericName=Media Synchronization
Comment=Upload media and synchronize local folders with Immich
Exec=immich-folder-watch %U
Icon=io.github.voltkraft.immich-folder-watch
Categories=Graphics;Photography;
Keywords=immich;photo;photos;backup;upload;watch;sync;
Terminal=false
StartupNotify=true
StartupWMClass=immich-folder-watch
