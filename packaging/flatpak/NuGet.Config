<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- Flatpak Builder uses a fresh HOME for each build command. Keep the
         restored archives available to the subsequent provenance verifier. -->
    <add key="globalPackagesFolder" value="../../artifacts/nuget-packages" />
  </config>
  <packageSources>
    <clear />
    <add key="reduced-avalonia" value="../../artifacts/reduced-avalonia/feed" />
    <add key="nuget.org" value="../../nuget-sources" />
  </packageSources>
  <fallbackPackageFolders><clear /></fallbackPackageFolders>
  <packageSourceMapping>
    <packageSource key="reduced-avalonia">
      <package pattern="Avalonia" />
      <package pattern="Avalonia.Themes.Fluent" />
    </packageSource>
    <packageSource key="nuget.org"><package pattern="*" /></packageSource>
  </packageSourceMapping>
</configuration>
