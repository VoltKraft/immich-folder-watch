+/// The HTTP challenge fields sent by the selected proxy on a refused CONNECT.
+#[derive(Debug)]
+pub struct ProxyAuthChallenge(HeaderMap);
+
+impl ProxyAuthChallenge {
+    /// Return the Proxy-Authenticate fields from this CONNECT response.
+    pub fn headers(&self) -> &HeaderMap {
+        &self.0
+    }
+}
+
+impl std::fmt::Display for ProxyAuthChallenge {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("proxy authentication challenge")
+    }
+}
+
+impl StdError for ProxyAuthChallenge {}
