 impl WindowFlags {
+    // A visible decorated application window can change WS_VISIBLE via ShowWindow alone.
+    // Retain the original initial-placement and style paths for every other transition.
+    fn retained_visibility(
+        self,
+        new: Self,
+        started: &mut bool,
+        is_visible: impl FnOnce() -> bool,
+    ) -> Option<i32> {
+        let required = Self::ON_TASKBAR | Self::MARKER_DECORATIONS;
+        let ordinary = required
+            | Self::RESIZABLE
+            | Self::MINIMIZABLE
+            | Self::MAXIMIZABLE
+            | Self::CLOSABLE
+            | Self::MARKER_ACTIVATE
+            | Self::CLIP_CHILDREN
+            | Self::VISIBLE;
+        if (self ^ new) != Self::VISIBLE || !new.contains(required) || !(new - ordinary).is_empty() {
+            return None;
+        }
+        let showing = new.contains(Self::VISIBLE);
+        if !*started {
+            if showing || !is_visible() {
+                return None;
+            }
+            *started = true;
+        }
+        Some(if !showing {
+            SW_HIDE
+        } else if self.contains(Self::MARKER_ACTIVATE) {
+            SW_SHOW
+        } else {
+            SW_SHOWNOACTIVATE
+        })
+    }
+
