<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <BrandProjectRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../..'))</BrandProjectRoot>
    <BrandLogoSvg>$([System.IO.Path]::Combine('$(BrandProjectRoot)', 'assets', 'branding', 'logo.svg'))</BrandLogoSvg>
    <BrandOutputRoot>$([System.IO.Path]::Combine('$(BrandProjectRoot)', 'artifacts', 'branding'))</BrandOutputRoot>
    <BrandWindowsIcon>$([System.IO.Path]::Combine('$(BrandOutputRoot)', 'windows', 'app.ico'))</BrandWindowsIcon>
    <BrandHeaderLogo>$([System.IO.Path]::Combine('$(BrandOutputRoot)', 'gui', 'header-logo.png'))</BrandHeaderLogo>
    <BrandFlatpakSvg>$([System.IO.Path]::Combine('$(BrandOutputRoot)', 'flatpak', 'io.github.voltkraft.immich-folder-watch.svg'))</BrandFlatpakSvg>
    <BrandFlatpakPng>$([System.IO.Path]::Combine('$(BrandOutputRoot)', 'flatpak', 'io.github.voltkraft.immich-folder-watch.png'))</BrandFlatpakPng>
    <BrandDotNetHost Condition="'$(DotNetHostPath)' != ''">$(DotNetHostPath)</BrandDotNetHost>
    <BrandDotNetHost Condition="'$(BrandDotNetHost)' == '' and '$(OS)' == 'Windows_NT'">$([System.IO.Path]::GetFullPath('$(MSBuildBinPath)\..\..\dotnet.exe'))</BrandDotNetHost>
    <BrandDotNetHost Condition="'$(BrandDotNetHost)' == '' and '$(OS)' != 'Windows_NT'">$([System.IO.Path]::GetFullPath('$(MSBuildBinPath)/../../dotnet'))</BrandDotNetHost>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="3.119.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.1" />
    <PackageReference Include="Svg.Skia" Version="3.6.0" />
  </ItemGroup>

  <ItemGroup>
    <BrandAssetGeneratorInputs Include="$(BrandLogoSvg)" />
    <BrandAssetGeneratorInputs Include="$(MSBuildProjectDirectory)/**/*.cs;$(MSBuildProjectDirectory)/**/*.csproj"
                               Exclude="$(MSBuildProjectDirectory)/bin/**/*;$(MSBuildProjectDirectory)/obj/**/*" />
  </ItemGroup>

  <!--
    Run the freshly-built generator once, right after this project's
    own build. App.csproj and App.Linux.csproj reference us via
    ProjectReference only for build ordering — they don't invoke the
    generator themselves anymore. MSBuild's project cache keeps a
    single in-memory build of this csproj per (Configuration), so
    both heads of the solution build observe one execution and the
    artifacts/branding/* outputs aren't written concurrently.

    Inputs/Outputs make the target a no-op once the artifacts are
    fresh; touching logo.svg or any of the generator sources
    re-triggers it.
  -->
  <Target Name="GenerateBrandAssets"
          AfterTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true'"
          Inputs="@(BrandAssetGeneratorInputs)"
          Outputs="$(BrandWindowsIcon);$(BrandHeaderLogo);$(BrandFlatpakSvg);$(BrandFlatpakPng)">
    <!--
      Invoke via $(TargetPath) directly so this target always runs the
      generator built by its ProjectReference. The application projects
      remove target RuntimeIdentifier and SelfContained properties from
      this host tool: a cross-published ARM64 application must not try to
      execute an ARM64 generator on an x64 build runner.
    -->
    <Exec Command="&quot;$(BrandDotNetHost)&quot; &quot;$(TargetPath)&quot; --project-root &quot;$(BrandProjectRoot)&quot; --logo &quot;$(BrandLogoSvg)&quot; --output-root &quot;$(BrandOutputRoot)&quot;" />
  </Target>
</Project>
