<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <add key="globalPackagesFolder" value="artifacts/nuget-packages" />
  </config>
  <packageSources>
    <clear />
    <add key="immich-folder-watch-reduced" value="artifacts/reduced-avalonia/feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="immich-folder-watch-reduced">
      <package pattern="Avalonia" />
      <package pattern="Avalonia.Themes.Fluent" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
