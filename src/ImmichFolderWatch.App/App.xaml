<Application x:Class="ImmichFolderWatch.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:ImmichFolderWatch.App.Services"
             xmlns:sharedServices="clr-namespace:ImmichFolderWatch.App.Shared.Services;assembly=ImmichFolderWatch.App.Shared"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Styles/PaletteDark.xaml" />
        <ResourceDictionary Source="/Styles/Styles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <sharedServices:LocalizationProxy x:Key="Loc" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
