<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:ImmichFolderWatch.App.Controls"
        x:Class="ImmichFolderWatch.App.MainWindow"
        Title="Immich Folder Watch"
        Icon="avares://ImmichFolderWatch.App/Assets/app-icon.ico"
        Width="1080"
        Height="860"
        MinWidth="960"
        MinHeight="760">
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Grid.Row="0"
            Classes="app-header"
            Padding="24"
            CornerRadius="0,0,24,24">
      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
        <StackPanel Grid.Row="0"
                    Grid.RowSpan="2"
                    Orientation="Horizontal"
                    Spacing="16">
          <Border Width="48"
                  Height="48"
                  Padding="4"
                  CornerRadius="16"
                  Background="#14FFFFFF"
                  BorderBrush="#33FFFFFF"
                  BorderThickness="1">
            <Image Width="40"
                   Height="40"
                   Stretch="Uniform"
                   Source="avares://ImmichFolderWatch.App/Assets/header-logo.png" />
          </Border>

          <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Classes="header-title"
                         Text="Immich Folder Watch"
                         FontSize="30"
                         FontWeight="Bold" />
              <controls:StatusPill VerticalAlignment="Center"
                                   Text="{Binding SyncStatusBadgeText}"
                                   Tone="{Binding SyncStatusBadgeTone}" />
            </StackPanel>

            <TextBlock Classes="header-subtitle"
                       Text="{Binding StatusHeadline}"
                       FontSize="16"
                       TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    Margin="24,0,0,0"
                    Spacing="6">
          <TextBlock Classes="header-title"
                     Text="{Binding ProductVersionText}"
                     FontWeight="SemiBold"
                     TextAlignment="Right"
                     TextWrapping="NoWrap"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Classes="header-meta"
                     Text="{Binding StatusDetails}"
                     TextAlignment="Right"
                     TextWrapping="NoWrap"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1">
      <StackPanel Margin="18" Spacing="18">
        <Border Classes="card">
          <StackPanel>
            <TextBlock Classes="section-title" Text="Status" />
            <Grid ColumnDefinitions="220,*,Auto"
                  RowDefinitions="Auto,Auto,Auto,Auto"
                  ColumnSpacing="12"
                  RowSpacing="12">
              <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Server-Verbindung" />
              <TextBlock Grid.Row="0" Grid.Column="1" Classes="muted" VerticalAlignment="Center" Text="{Binding ServerConnectionDetail}" />
              <controls:StatusPill Grid.Row="0"
                                   Grid.Column="2"
                                   VerticalAlignment="Center"
                                   Text="{Binding ServerConnectionText}"
                                   Tone="{Binding ServerConnectionTone}" />

              <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Letzter Sync" />
              <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Classes="muted" VerticalAlignment="Center" Text="{Binding LastSyncText}" />

              <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="Aktueller Sync" />
              <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Classes="muted" VerticalAlignment="Center" Text="{Binding CurrentUploadText}" TextWrapping="Wrap" />

              <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Text="Wartende Dateien" />
              <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Classes="muted" VerticalAlignment="Center" Text="{Binding PendingCountText}" />
            </Grid>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="10">
            <TextBlock Classes="section-title" Text="Autostart" Margin="0" />
            <CheckBox IsChecked="{Binding AutostartEnabled}"
                      Content="Beim Anmelden starten" />
            <TextBlock Classes="muted"
                       Text="Ein Shortcut im Autostart-Ordner sorgt dafür, dass die Anwendung bei jeder Anmeldung im Hintergrund gestartet wird." />
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel>
            <TextBlock Classes="section-title" Text="Immich" />

            <Grid ColumnDefinitions="220,*,Auto"
                  RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                  ColumnSpacing="12"
                  RowSpacing="12">
              <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Server API URL" />
              <TextBox Grid.Row="0"
                       Grid.Column="1"
                       Text="{Binding ImmichServerApiUrl}"
                       Watermark="https://immich.example.com/api" />
              <controls:StatusPill Grid.Row="0"
                                   Grid.Column="2"
                                   VerticalAlignment="Center"
                                   Text="{Binding ImmichUrlStatusText}"
                                   Tone="{Binding ImmichUrlStatusTone}" />

              <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="API Key" />
              <Grid Grid.Row="1"
                    Grid.Column="1"
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="8">
                <TextBox Grid.Column="0"
                         IsVisible="{Binding ShowPlainImmichApiKeyInput}"
                         Text="{Binding ImmichApiKey}"
                         Watermark="{Binding ImmichApiKeyPlaceholderText}" />
                <TextBox Grid.Column="0"
                         IsVisible="{Binding ShouldMaskImmichApiKey}"
                         Text="{Binding ImmichApiKey}"
                         Watermark="{Binding ImmichApiKeyPlaceholderText}"
                         PasswordChar="●" />
                <Button Grid.Column="1"
                        Classes="icon"
                        IsVisible="{Binding ShowImmichApiKeyRevealButton}"
                        Click="ToggleApiKeyVisibilityButton_Click"
                        ToolTip.Tip="{Binding ImmichApiKeyRevealToolTip}">
                  <PathIcon Width="16"
                            Height="16"
                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            Data="M12,17C7,17 2.73,13.89 1,9.5C2.73,5.11 7,2 12,2C17,2 21.27,5.11 23,9.5C21.27,13.89 17,17 12,17ZM12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9Z" />
                </Button>
              </Grid>
              <controls:StatusPill Grid.Row="1"
                                   Grid.Column="2"
                                   VerticalAlignment="Center"
                                   Text="{Binding ImmichApiKeyStatusText}"
                                   Tone="{Binding ImmichApiKeyStatusTone}" />

              <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="Permissions" />
              <TextBlock Grid.Row="2"
                         Grid.Column="1"
                         Classes="muted"
                         VerticalAlignment="Center"
                         Text="Checks the permissions needed for uploads and optional album placement." />
              <controls:StatusPill Grid.Row="2"
                                   Grid.Column="2"
                                   VerticalAlignment="Center"
                                   Text="{Binding ImmichPermissionsStatusText}"
                                   Tone="{Binding ImmichPermissionsStatusTone}" />

              <ItemsControl Grid.Row="3"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            ItemsSource="{Binding ImmichPermissionStatuses}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="muted-surface"
                            Margin="0,0,0,8"
                            Padding="12">
                      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                          <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                          <TextBlock Classes="muted" Text="{Binding PermissionName}" />
                        </StackPanel>
                        <controls:StatusPill Grid.Row="0"
                                             Grid.Column="1"
                                             VerticalAlignment="Center"
                                             Text="{Binding StatusText}"
                                             Tone="{Binding StatusTone}" />
                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="2"
                                   Classes="muted"
                                   Text="{Binding Message}"
                                   TextWrapping="Wrap" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Button Grid.Row="4"
                      Grid.Column="1"
                      Classes="secondary"
                      HorizontalAlignment="Left"
                      Click="VerifyImmichButton_Click"
                      Content="Verify Immich Access" />
            </Grid>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel>
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
              <TextBlock Grid.Column="0" Classes="section-title" Text="Watch Sources" Margin="0" />
              <Button Grid.Column="1" Classes="secondary" Click="AddSourceButton_Click" Content="Add Source" />
            </Grid>

            <ItemsControl ItemsSource="{Binding Sources}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Classes="muted-surface"
                          Margin="0,0,0,12"
                          Padding="14">
                    <StackPanel Spacing="10">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Text="Watch Source" />
                        <Button Grid.Column="1"
                                Classes="secondary"
                                HorizontalAlignment="Right"
                                Click="RemoveSourceButton_Click"
                                Content="Remove" />
                      </Grid>

                      <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Folder Path" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Immich Album Name" />
                        <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding Path}" Watermark="C:\Users\...\Pictures\Screenshots" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding AlbumName}" Watermark="Leave empty for no album" />
                      </Grid>

                      <Expander IsExpanded="{Binding ShowAdvancedOptions}">
                        <Expander.Header>
                          <TextBlock FontWeight="SemiBold" Text="Advanced Watch Options" />
                        </Expander.Header>

                        <StackPanel Margin="0,12,0,0" Spacing="10">
                          <CheckBox IsChecked="{Binding IncludeSubdirectories}"
                                    Content="Include subdirectories" />

                          <StackPanel Spacing="6">
                            <TextBlock Text="Extensions" />
                            <TextBox Height="120"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Text="{Binding ExtensionsText}"
                                     Watermark=".jpg&#10;.jpeg&#10;.heic" />
                          </StackPanel>

                          <StackPanel Spacing="6"
                                      IsVisible="{Binding ShowExcludeDirectories}">
                            <TextBlock Text="Excluded Directories" />
                            <TextBox Height="120"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Text="{Binding ExcludeDirectoriesText}"
                                     Watermark="private&#10;**/cache" />
                          </StackPanel>

                          <StackPanel Spacing="6">
                            <TextBlock Text="Excluded File Names" />
                            <TextBox Height="96"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Text="{Binding ExcludeFileNamesText}"
                                     Watermark="Thumbs.db&#10;*.tmp" />
                          </StackPanel>
                        </StackPanel>
                      </Expander>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel>
            <TextBlock Classes="section-title" Text="Watch Behavior" />
            <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="12">
              <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Batch Interval Seconds" />
              <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding BatchIntervalSeconds}" />

              <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Max Batch Size" />
              <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MaxBatchSize}" />

              <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="File Ready Timeout Seconds" />
              <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding FileReadyTimeoutSeconds}" />

              <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Text="Retry Max Attempts" />
              <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding RetryMaxAttempts}" />
            </Grid>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel>
            <TextBlock Classes="section-title" Text="Logging And Retry" />
            <Grid ColumnDefinitions="220,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="12">
              <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Retry Base Delay (ms)" />
              <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding RetryBaseDelayMilliseconds}" />

              <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Log Level" />
              <ComboBox Grid.Row="1"
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        ItemsSource="{Binding AvailableLogLevels}"
                        SelectedItem="{Binding LoggingLevel}" />

              <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="Log Directory" />
              <TextBox Grid.Row="2"
                       Grid.Column="1"
                       Text="{Binding LogDirectory}"
                       Watermark="%LOCALAPPDATA%\Immich Folder Watch\logs" />
              <Button Grid.Row="2"
                      Grid.Column="2"
                      Classes="secondary"
                      Click="UseDefaultLogDirectoryButton_Click"
                      Content="Use Default" />

              <TextBlock Grid.Row="3"
                         Grid.Column="1"
                         Grid.ColumnSpan="2"
                         Classes="muted"
                         Text="Log Directory must be configured as an absolute path." />
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2"
            Classes="app-footer"
            Padding="18">
      <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="12" RowDefinitions="Auto,Auto">
        <Button Grid.Row="0"
                Grid.Column="0"
                Classes="secondary"
                Click="OpenLogsButton_Click"
                Content="Open Logs" />
        <Button Grid.Row="0"
                Grid.Column="1"
                Classes="primary"
                Click="SaveActionButton_Click"
                Content="{Binding SaveActionButtonText}" />
        <TextBlock Grid.Row="1"
                   Grid.Column="0"
                   Grid.ColumnSpan="3"
                   Margin="0,12,0,0"
                   Text="{Binding OperationMessage}"
                   TextWrapping="Wrap" />
      </Grid>
    </Border>
  </Grid>
</Window>
