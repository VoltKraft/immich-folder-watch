<Window x:Class="ImmichFolderWatch.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ImmichFolderWatch.App.Controls"
        xmlns:services="clr-namespace:ImmichFolderWatch.App.Services"
        Title="Immich Folder Watch"
        Width="1080"
        Height="860"
        MinWidth="960"
        MinHeight="760"
        Background="{DynamicResource AppWindowBackground}"
        Foreground="{DynamicResource AppPrimaryText}"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Style="{StaticResource AppHeaderBorder}"
            Padding="24"
            CornerRadius="0,0,24,24">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="0"
                    Orientation="Horizontal">
          <Border Width="48"
                  Height="48"
                  Padding="4"
                  CornerRadius="16"
                  Background="#14FFFFFF"
                  BorderBrush="#33FFFFFF"
                  BorderThickness="1">
            <Image Width="40"
                   Height="40"
                   Stretch="Uniform"
                   Source="pack://application:,,,/Assets/header-logo.png" />
          </Border>

          <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource HeaderTitleText}"
                         Text="Immich Folder Watch"
                         FontSize="30"
                         FontWeight="Bold" />
              <controls:StatusPill Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="{Binding SyncStatusBadgeText}"
                                   Tone="{Binding SyncStatusBadgeTone}" />
            </StackPanel>

            <TextBlock Margin="0,8,0,0"
                       Style="{StaticResource HeaderSubtitleText}"
                       Text="{Binding StatusHeadline}"
                       FontSize="16"
                       TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    Margin="24,0,0,0">
          <TextBlock Style="{StaticResource HeaderTitleText}"
                     Text="{Binding ProductVersionText}"
                     FontWeight="SemiBold"
                     TextAlignment="Right"
                     TextWrapping="NoWrap"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Margin="0,6,0,0"
                     Style="{StaticResource HeaderMetaText}"
                     Text="{Binding StatusDetails}"
                     TextAlignment="Right"
                     TextWrapping="NoWrap"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1">
      <StackPanel Margin="18">
        <Border Style="{StaticResource CardBorder}">
          <StackPanel>
            <TextBlock Style="{StaticResource SectionTitleText}" Text="Status" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,12,12" VerticalAlignment="Center" Text="Server-Verbindung" />
              <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,12,12" Style="{StaticResource MutedText}" VerticalAlignment="Center" Text="{Binding ServerConnectionDetail}" />
              <controls:StatusPill Grid.Row="0" Grid.Column="2" Margin="0,0,0,12" VerticalAlignment="Center" Text="{Binding ServerConnectionText}" Tone="{Binding ServerConnectionTone}" />

              <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,12,12" VerticalAlignment="Center" Text="Letzter Sync" />
              <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,12" Style="{StaticResource MutedText}" VerticalAlignment="Center" Text="{Binding LastSyncText}" />

              <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,12,12" VerticalAlignment="Center" Text="Aktueller Sync" />
              <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,12" Style="{StaticResource MutedText}" VerticalAlignment="Center" Text="{Binding CurrentUploadText}" TextWrapping="Wrap" />

              <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center" Text="Wartende Dateien" />
              <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource MutedText}" VerticalAlignment="Center" Text="{Binding PendingCountText}" />
            </Grid>
          </StackPanel>
        </Border>

        <Border Margin="0,18,0,0" Style="{StaticResource CardBorder}">
          <StackPanel>
            <TextBlock Style="{StaticResource SectionTitleText}" Text="Autostart" Margin="0" />
            <CheckBox Margin="0,10,0,0"
                      IsChecked="{Binding AutostartEnabled}"
                      Content="Beim Anmelden starten" />
            <TextBlock Margin="0,10,0,0"
                       Style="{StaticResource MutedText}"
                       Text="Ein Shortcut im Autostart-Ordner sorgt dafür, dass die Anwendung bei jeder Anmeldung im Hintergrund gestartet wird."
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Margin="0,18,0,0" Style="{StaticResource CardBorder}">
          <StackPanel>
            <TextBlock Style="{StaticResource SectionTitleText}" Text="Immich" />

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,12,12" VerticalAlignment="Center" Text="Server API URL" />
              <TextBox Grid.Row="0"
                       Grid.Column="1"
                       Margin="0,0,12,12"
                       Text="{Binding ImmichServerApiUrl, UpdateSourceTrigger=PropertyChanged}"
                       services:WatermarkBehavior.Watermark="https://immich.example.com/api" />
              <controls:StatusPill Grid.Row="0" Grid.Column="2" Margin="0,0,0,12" VerticalAlignment="Center" Text="{Binding ImmichUrlStatusText}" Tone="{Binding ImmichUrlStatusTone}" />

              <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,12,12" VerticalAlignment="Center" Text="API Key" />
              <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,12,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Visibility="{Binding ShowPlainImmichApiKeyInput, Converter={StaticResource BoolToVis}}"
                         Text="{Binding ImmichApiKey, UpdateSourceTrigger=PropertyChanged}"
                         services:WatermarkBehavior.Watermark="{Binding ImmichApiKeyPlaceholderText}" />
                <PasswordBox Grid.Column="0"
                             Visibility="{Binding ShouldMaskImmichApiKey, Converter={StaticResource BoolToVis}}"
                             services:PasswordBoxHelper.BindablePassword="{Binding ImmichApiKey, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                             services:WatermarkBehavior.Watermark="{Binding ImmichApiKeyPlaceholderText}" />
                <Button Grid.Column="1"
                        Margin="8,0,0,0"
                        Style="{StaticResource IconButton}"
                        Visibility="{Binding ShowImmichApiKeyRevealButton, Converter={StaticResource BoolToVis}}"
                        Click="ToggleApiKeyVisibilityButton_Click"
                        ToolTip="{Binding ImmichApiKeyRevealToolTip}">
                  <Path Width="16"
                        Height="16"
                        Stretch="Uniform"
                        Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        Data="M12,17C7,17 2.73,13.89 1,9.5C2.73,5.11 7,2 12,2C17,2 21.27,5.11 23,9.5C21.27,13.89 17,17 12,17ZM12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9Z" />
                </Button>
              </Grid>
              <controls:StatusPill Grid.Row="1" Grid.Column="2" Margin="0,0,0,12" VerticalAlignment="Center" Text="{Binding ImmichApiKeyStatusText}" Tone="{Binding ImmichApiKeyStatusTone}" />

              <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,12,12" VerticalAlignment="Center" Text="Permissions" />
              <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,0,12,12" Style="{StaticResource MutedText}" VerticalAlignment="Center" Text="Checks the permissions needed for uploads and optional album placement." TextWrapping="Wrap" />
              <controls:StatusPill Grid.Row="2" Grid.Column="2" Margin="0,0,0,12" VerticalAlignment="Center" Text="{Binding ImmichPermissionsStatusText}" Tone="{Binding ImmichPermissionsStatusTone}" />

              <ItemsControl Grid.Row="3"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Margin="0,0,0,12"
                            ItemsSource="{Binding ImmichPermissionStatuses}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource MutedSurfaceBorder}"
                            Margin="0,0,0,8"
                            Padding="12">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0">
                          <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                          <TextBlock Margin="0,2,0,0" Style="{StaticResource MutedText}" Text="{Binding PermissionName}" />
                        </StackPanel>
                        <controls:StatusPill Grid.Row="0"
                                             Grid.Column="1"
                                             Margin="12,0,0,0"
                                             VerticalAlignment="Center"
                                             Text="{Binding StatusText}"
                                             Tone="{Binding StatusTone}" />
                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="2"
                                   Margin="0,8,0,0"
                                   Style="{StaticResource MutedText}"
                                   Text="{Binding Message}"
                                   TextWrapping="Wrap" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Button Grid.Row="4"
                      Grid.Column="1"
                      Style="{StaticResource SecondaryButton}"
                      HorizontalAlignment="Left"
                      Click="VerifyImmichButton_Click"
                      Content="Verify Immich Access" />
            </Grid>
          </StackPanel>
        </Border>

        <Border Margin="0,18,0,0" Style="{StaticResource CardBorder}">
          <StackPanel>
            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Style="{StaticResource SectionTitleText}" Text="Watch Sources" Margin="0" />
              <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Click="AddSourceButton_Click" Content="Add Source" />
            </Grid>

            <ItemsControl ItemsSource="{Binding Sources}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource MutedSurfaceBorder}"
                          Margin="0,0,0,12"
                          Padding="14">
                    <StackPanel>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Text="Watch Source" />
                        <Button Grid.Column="1"
                                Margin="10,0,0,0"
                                Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Right"
                                Click="RemoveSourceButton_Click"
                                Content="Remove" />
                      </Grid>

                      <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,5,0" Text="Folder Path" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Margin="5,0,0,0" Text="Immich Album Name" />
                        <TextBox Grid.Row="1" Grid.Column="0" Margin="0,6,5,0" Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" services:WatermarkBehavior.Watermark="C:\Users\...\Pictures\Screenshots" />
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="5,6,0,0" Text="{Binding AlbumName, UpdateSourceTrigger=PropertyChanged}" services:WatermarkBehavior.Watermark="Leave empty for no album" />
                      </Grid>

                      <Expander Margin="0,10,0,0" IsExpanded="{Binding ShowAdvancedOptions}">
                        <Expander.Header>
                          <TextBlock FontWeight="SemiBold" Text="Advanced Watch Options" />
                        </Expander.Header>

                        <StackPanel Margin="0,12,0,0">
                          <CheckBox IsChecked="{Binding IncludeSubdirectories}"
                                    Content="Include subdirectories" />

                          <StackPanel Margin="0,10,0,0">
                            <TextBlock Text="Extensions" />
                            <TextBox Margin="0,6,0,0"
                                     Height="120"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Text="{Binding ExtensionsText, UpdateSourceTrigger=PropertyChanged}"
                                     services:WatermarkBehavior.Watermark=".jpg&#10;.jpeg&#10;.heic" />
                          </StackPanel>

                          <StackPanel Margin="0,10,0,0"
                                      Visibility="{Binding ShowExcludeDirectories, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Excluded Directories" />
                            <TextBox Margin="0,6,0,0"
                                     Height="120"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Text="{Binding ExcludeDirectoriesText, UpdateSourceTrigger=PropertyChanged}"
                                     services:WatermarkBehavior.Watermark="private&#10;**/cache" />
                          </StackPanel>

                          <StackPanel Margin="0,10,0,0">
                            <TextBlock Text="Excluded File Names" />
                            <TextBox Margin="0,6,0,0"
                                     Height="96"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Text="{Binding ExcludeFileNamesText, UpdateSourceTrigger=PropertyChanged}"
                                     services:WatermarkBehavior.Watermark="Thumbs.db&#10;*.tmp" />
                          </StackPanel>
                        </StackPanel>
                      </Expander>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Margin="0,18,0,0" Style="{StaticResource CardBorder}">
          <StackPanel>
            <TextBlock Style="{StaticResource SectionTitleText}" Text="Watch Behavior" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,12,12" VerticalAlignment="Center" Text="Batch Interval Seconds" />
              <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,12" Text="{Binding BatchIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" />

              <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,12,12" VerticalAlignment="Center" Text="Max Batch Size" />
              <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,12" Text="{Binding MaxBatchSize, UpdateSourceTrigger=PropertyChanged}" />

              <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,12,12" VerticalAlignment="Center" Text="File Ready Timeout Seconds" />
              <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,12" Text="{Binding FileReadyTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" />

              <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center" Text="Retry Max Attempts" />
              <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding RetryMaxAttempts, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
          </StackPanel>
        </Border>

        <Border Margin="0,18,0,0" Style="{StaticResource CardBorder}">
          <StackPanel>
            <TextBlock Style="{StaticResource SectionTitleText}" Text="Logging And Retry" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,12,12" VerticalAlignment="Center" Text="Retry Base Delay (ms)" />
              <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,12" Text="{Binding RetryBaseDelayMilliseconds, UpdateSourceTrigger=PropertyChanged}" />

              <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,12,12" VerticalAlignment="Center" Text="Log Level" />
              <ComboBox Grid.Row="1"
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        Margin="0,0,0,12"
                        ItemsSource="{Binding AvailableLogLevels}"
                        SelectedItem="{Binding LoggingLevel}" />

              <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,12,12" VerticalAlignment="Center" Text="Log Directory" />
              <TextBox Grid.Row="2"
                       Grid.Column="1"
                       Margin="0,0,12,12"
                       Text="{Binding LogDirectory, UpdateSourceTrigger=PropertyChanged}"
                       services:WatermarkBehavior.Watermark="%LOCALAPPDATA%\Immich Folder Watch\logs" />
              <Button Grid.Row="2"
                      Grid.Column="2"
                      Margin="0,0,0,12"
                      Style="{StaticResource SecondaryButton}"
                      Click="UseDefaultLogDirectoryButton_Click"
                      Content="Use Default" />

              <TextBlock Grid.Row="3"
                         Grid.Column="1"
                         Grid.ColumnSpan="2"
                         Style="{StaticResource MutedText}"
                         Text="Log Directory must be configured as an absolute path."
                         TextWrapping="Wrap" />
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2"
            Style="{StaticResource AppFooterBorder}"
            Padding="18">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Button Grid.Row="0"
                Grid.Column="0"
                Style="{StaticResource SecondaryButton}"
                Click="OpenLogsButton_Click"
                Content="Open Logs" />
        <Button Grid.Row="0"
                Grid.Column="1"
                Margin="12,0,0,0"
                Style="{StaticResource PrimaryButton}"
                Click="SaveActionButton_Click"
                Content="{Binding SaveActionButtonText}" />
        <TextBlock Grid.Row="1"
                   Grid.Column="0"
                   Grid.ColumnSpan="3"
                   Margin="0,12,0,0"
                   Text="{Binding OperationMessage}"
                   TextWrapping="Wrap" />
      </Grid>
    </Border>
  </Grid>
</Window>
