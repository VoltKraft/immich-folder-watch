<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <StartupObject>ImmichFolderWatch.App.Program</StartupObject>
    <RootNamespace>ImmichFolderWatch.App</RootNamespace>
    <AssemblyName>ImmichFolderWatch</AssemblyName>
    <AssemblyTitle>Immich Folder Watch</AssemblyTitle>
    <Product>Immich Folder Watch</Product>
    <Company>Immich Folder Watch</Company>
    <BrandProjectRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../..'))</BrandProjectRoot>
    <BrandGeneratorProject>$([System.IO.Path]::Combine('$(BrandProjectRoot)', 'tools', 'BrandAssetGen', 'BrandAssetGen.csproj'))</BrandGeneratorProject>
    <BrandLogoSvg>$([System.IO.Path]::Combine('$(BrandProjectRoot)', 'assets', 'branding', 'logo.svg'))</BrandLogoSvg>
    <BrandOutputRoot>$([System.IO.Path]::Combine('$(BrandProjectRoot)', 'artifacts', 'branding'))</BrandOutputRoot>
    <BrandWindowsIcon>$([System.IO.Path]::Combine('$(BrandOutputRoot)', 'windows', 'app.ico'))</BrandWindowsIcon>
    <BrandHeaderLogo>$([System.IO.Path]::Combine('$(BrandOutputRoot)', 'gui', 'header-logo.png'))</BrandHeaderLogo>
    <BrandFlatpakSvg>$([System.IO.Path]::Combine('$(BrandOutputRoot)', 'flatpak', 'io.github.voltkraft.ImmichFolderWatch.svg'))</BrandFlatpakSvg>
    <BrandFlatpakPng>$([System.IO.Path]::Combine('$(BrandOutputRoot)', 'flatpak', 'io.github.voltkraft.ImmichFolderWatch.png'))</BrandFlatpakPng>
    <ApplicationIcon>$(BrandWindowsIcon)</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../ImmichFolderWatch.Core/ImmichFolderWatch.Core.csproj" />
    <ProjectReference Include="../ImmichFolderWatch.Immich/ImmichFolderWatch.Immich.csproj" />
    <ProjectReference Include="../ImmichFolderWatch.App.Shared/ImmichFolderWatch.App.Shared.csproj" />
    <!--
      Build-order-only dependency on BrandAssetGen so the solution
      doesn't compile the tool concurrently from both App.csproj and
      App.Linux.csproj's GenerateBrandAssets targets (post-3.8.A both
      heads invoke the generator). The parallel compile races on
      tools/BrandAssetGen/obj/.../AssemblyInfoInputs.cache and breaks
      the Windows CI build with MSB3491. ReferenceOutputAssembly=false
      keeps the tool out of our publish output.
    -->
    <ProjectReference Include="$(BrandGeneratorProject)"
                      ReferenceOutputAssembly="false"
                      Private="false" />
  </ItemGroup>

  <ItemGroup>
    <BrandAssetGeneratorInputs Include="$(BrandLogoSvg)" />
    <BrandAssetGeneratorInputs Include="$(BrandProjectRoot)/tools/BrandAssetGen/**/*.cs;$(BrandProjectRoot)/tools/BrandAssetGen/**/*.csproj"
                               Exclude="$(BrandProjectRoot)/tools/BrandAssetGen/bin/**/*;$(BrandProjectRoot)/tools/BrandAssetGen/obj/**/*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.EventLog" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="$(BrandWindowsIcon)" Link="Assets/app-icon.ico" />
    <Resource Include="$(BrandHeaderLogo)" Link="Assets/header-logo.png" />
  </ItemGroup>

  <Target Name="GenerateBrandAssets"
          BeforeTargets="BeforeBuild;MarkupCompilePass1"
          Condition="'$(DesignTimeBuild)' != 'true'"
          Inputs="@(BrandAssetGeneratorInputs)"
          Outputs="$(BrandWindowsIcon);$(BrandHeaderLogo);$(BrandFlatpakSvg);$(BrandFlatpakPng)">
    <!--
      Explicit MSBuild invocation on BrandAssetGen.csproj before the
      Exec, instead of trusting the ProjectReference + dotnet run
      combination that worked locally but failed on CI (the runner
      hit the no-build flag with no compiled binary in
      tools/BrandAssetGen/bin/Release/net10.0/, so dotnet run errored
      with "No such file or directory" before producing any output).
      MSBuild's own project cache makes a parallel App.Linux.csproj
      invocation fold into the same in-memory build, so the
      cache-file race that motivated the no-build flag is also
      avoided. The Exec then just runs the freshly-built binary.
    -->
    <MSBuild Projects="$(BrandGeneratorProject)"
             Targets="Build"
             Properties="Configuration=$(Configuration)" />
    <Exec Command="dotnet run --project &quot;$(BrandGeneratorProject)&quot; --configuration $(Configuration) --no-build -- --project-root &quot;$(BrandProjectRoot)&quot; --logo &quot;$(BrandLogoSvg)&quot; --output-root &quot;$(BrandOutputRoot)&quot;" />
  </Target>
</Project>
